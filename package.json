{
  "name": "rubber-yard-desktop",
  "version": "1.2.3",
  "description": "ลานยางพาราชุมชน — ระบบรับซื้อยาง (Desktop)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:publish": "electron-builder --win -p always",
    "build:portable": "electron-builder --win portable"
  },
  "author": "SANSUANG",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.12.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sansuang.rubber-yard",
    "productName": "ลานยางพาราชุมชน",
    "publish": [
      {
        "provider": "github",
        "owner": "toonsansuang-byte",
        "repo": "rubber-yard-app"
      }
    ],
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "database/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ลานยางพาราชุมชน",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "RubberYard-Setup-${version}.${ext}"
    }
  }
}
